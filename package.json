{
  "name": "codex-connector",
  "version": "0.2.0",
  "private": true,
  "description": "Shared Codex daemon control via strict Slack commands and scoped human approval",
  "type": "module",
  "bin": {
    "codex-connector": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js start"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.12.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
