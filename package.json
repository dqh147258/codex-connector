{
  "name": "codex-connector",
  "version": "0.2.0",
  "private": true,
  "description": "Shared Codex daemon control via strict Slack commands and scoped human approval",
  "type": "module",
  "bin": {
    "codex-connector": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js start",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.5",
    "@slack/web-api": "^7.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "typescript": "^5.9.3"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "io.github.dqh147258.codexconnector",
    "productName": "Codex Connector",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/src/**",
      "dist/desktop/**",
      "desktop/preload.cjs",
      "desktop/ui/**",
      "slack-app-manifest.json",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "artifactName": "codex-connector-desktop-${version}-${os}-${arch}.${ext}"
  }
}
